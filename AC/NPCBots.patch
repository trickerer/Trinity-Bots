+                case ITEM_CLASS_ARMOR:
+                    for (uint32 spellId : armor_enchants_caster)
+                    {
+                        sInfo = sSpellMgr->AssertSpellInfo(spellId);
+                        if (is_enchantable(proto, sInfo))
+                            valid_enchant_ids.push_back(uint32(sInfo->GetEffect(EFFECT_0).MiscValue));
