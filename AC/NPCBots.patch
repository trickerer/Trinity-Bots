+                value += 100.f;
+            //Glyph of Bloodthirst: +100% healing
+            if (baseId == BLOODTHIRST_1 && effIndex == EFFECT_1 && lvl >= 40)
+                pctbonus *= 2.0f;
+
+            value = value * pctbonus;
+        }
