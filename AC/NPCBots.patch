+            break;
+        case BOT_SPEC_DK_BLOOD:
+        case BOT_SPEC_DK_FROST:
+        case BOT_SPEC_DK_UNHOLY:
+            switch (proto->Class)
+            {
+                case ITEM_CLASS_WEAPON:
+                    for (uint32 spellId : weapon_enchants_dk)
+                    {
