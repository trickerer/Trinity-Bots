+#                     0 - (NpcBot.WanderingBots.KillReward.ItemCount)
+#                     0 - (NpcBot.WanderingBots.KillReward.ItemQuality)
+
+NpcBot.WanderingBots.KillReward.Money       = 0
+NpcBot.WanderingBots.KillReward.ItemCount   = 0
+NpcBot.WanderingBots.KillReward.ItemQuality = 0
+
+#
