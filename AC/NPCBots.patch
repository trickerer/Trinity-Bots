+                        (member->getAttackers().size() > 2 || GetHealthPCT(member) < 50) &&
+                        !member->GetAuraEffect(SPELL_AURA_SPLIT_DAMAGE_PCT, SPELLFAMILY_PALADIN, 0x2000, 0x0, 0x0))
