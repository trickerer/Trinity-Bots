+    private:
+        BotRuneInfo _runes[MAX_RUNES];
+
+/*tmrs*/uint32 presencetimer, runicpowertimer, runicpowertimer2;
+        uint32 rimeProcTimer;
+/*misc*/int32 runicpower;
+/*misc*/int32 runeCost[NUM_RUNE_TYPES];
