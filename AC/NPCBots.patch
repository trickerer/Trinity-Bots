+        }
+    }
+    else
+    {
+        if (ItemRandomSuffixEntry const* item_rand = sItemRandomSuffixStore.LookupEntry(-randomPropId))
+        {
+            std::array<char const*, 16> const& suffs = item_rand->Name;
+            //if (suffs)
