+        case BOT_PET_NECROSKELETON:
+        case BOT_PET_TORNADO:
+        case BOT_PET_CARRION_BEETLE1:
+        case BOT_PET_CARRION_BEETLE2:
+        case BOT_PET_CARRION_BEETLE3:
+        case BOT_PET_LOCUST_SWARM:
