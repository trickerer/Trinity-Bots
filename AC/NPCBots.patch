+WanderNode* WanderNode::FindInAllWPs(uint32 wpId)
+{
+    std::shared_lock lock(*GetLock());
+
+    auto ci = std::ranges::find_if(ALL_WPS, [wpId = wpId](WanderNode const* wp) {
+        return wp->GetWPId() == wpId;
+    });
+
+    return ci == ALL_WPS.cend() ? nullptr : *ci;
+}
