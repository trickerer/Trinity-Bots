+                else if (GetHealthPCT(me) < 50)
+                    DrinkPotion(false);
+            }
+
+            //CheckRacials(diff);
+
+            CheckWindWalk(diff);
+            CheckMirrorImage(diff);
+
+            if (!me->IsInCombat())
+                DoNonCombatActions(diff);
+
+            if (IsCasting())
+                return;
+
+            if (ProcessImmediateNonAttackTarget())
+                return;
+
+            if (!CheckAttackTarget())
+                return;
+
+            CheckUsableItems(diff);
+
+            Attack(diff);
+        }
+
