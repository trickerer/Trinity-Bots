+            else if (focu && focu->IsAffectedOnSpell(spellInfo))
+                me->RemoveAurasDueToSpell(INNER_FOCUS_1);
+
+            //Serendipity
+            if (AuraEffect const* sere = me->GetAuraEffect(SERENDIPITY_BUFF, 0))
