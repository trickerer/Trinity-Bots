+
+            return bot_ai::doCast(victim, spellId);
+        }
+
+        void UpdateAI(uint32 diff) override
+        {
+            IllusionsCheck(diff);
+
+            if (!GlobalUpdate(diff))
+                return;
+
+            DoVehicleActions(diff);
+            if (!CanBotAttackOnVehicle())
+                return;
+
+            if (IsPotionReady() && !IsTempBot())
+            {
+                if (me->GetPower(POWER_MANA) < MIRROR_COST)
