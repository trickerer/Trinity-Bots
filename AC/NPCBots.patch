+
+    FORKEDLIGHTNING_COST                = 110 * 5,
+    FROSTARROW_COST                     = 10 * 5,
+    TORNADO_COST                        = 250 * 5,
+
+    FORKED_LIGHTNING_EFFECT             = SPELL_FORKED_LIGHTNING_EFFECT,
+    FROST_ARROW_EFFECT                  = SPELL_FROST_ARROW_EFFECT,
+
+    NAGA_SWIM_PASSIVE                   = 40513,
