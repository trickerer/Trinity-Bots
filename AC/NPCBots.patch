+
+        uint32 GetAIMiscValue(uint32 data) const override
+        {
+            switch (data)
+            {
+                case BOTAI_MISC_PET_TYPE:
+                    return BOT_PET_AWATER_ELEMENTAL;
+                default:
+                    return 0;
+            }
+        }
+
+        void CheckAttackState() override
+        {
+        }
+
