+    RewardHonorToTeam(GetBonusHonorFromKill(2), GetBotTeamId(bot->GetGUID()));
+
+    if (GetTeamScore(TEAM_ALLIANCE) == BG_WS_MAX_TEAM_SCORE || GetTeamScore(TEAM_HORDE) == BG_WS_MAX_TEAM_SCORE)
