+        }
+        if (player == master || (gr && gr->IsMember(master->GetGUID())))
+        {
+            //class-specific for party: mage rations, rogue lockpicking etc.
+            //TODO: priest lightwell (manual only) maybe move into abilities
+            switch (_botclass)
