+        case BOT_SPEC_DRUID_RESTORATION:
+            switch (proto->Class)
+            {
+                case ITEM_CLASS_WEAPON:
+                    for (uint32 spellId : weapon_enchants_caster)
+                    {
+                        sInfo = sSpellMgr->AssertSpellInfo(spellId);
+                        if (is_enchantable(proto, sInfo))
