+                    if (me->GetMap() == member->FindMap() && member->IsAlive() && GetHealthPCT(member) <= 70 &&
+                        !member->HasAuraType(SPELL_AURA_ADD_CASTER_HIT_TRIGGER) &&
+                        member->getAttackers().size() >= me->getAttackers().size() &&
