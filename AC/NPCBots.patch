+                    //args.SetOriginalCaster(me->GetGUID());
+                    //petOwner->CastSpell(petOwner, GetSpell(FEL_INTELLIGENCE_1), args);
+                    SetSpellCooldown(FEL_INTELLIGENCE_1, uint32(-1));
