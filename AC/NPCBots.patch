+        }
+
+        void Reset() override
+        {
+            UnsummonAll(false);
+
+            checkAuraTimer = 0;
+
+            DefaultInit();
+        }
+
+        void ReduceCD(uint32 diff) override
+        {
+            if (checkAuraTimer > diff)              checkAuraTimer -= diff;
+        }
