+        else
+            AddGossipItemFor(player, GOSSIP_ICON_TAXI, message2.str(), GOSSIP_SENDER_HIRE, GOSSIP_ACTION_INFO_DEF + reason);
+
+        menus = true;
+    }
+
+    if (_botData->owner)
+    {
+        Group const* gr = player->GetGroup();
+
+        if (player == master)
+        {
+            menus = true;
+
+            //general: equips, roles, distance, abilities, comsumables, group
